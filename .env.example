# --- Database ---------------------------------------------------------------
# SQLite for local dev. To move to Postgres/Supabase later: change the
# `provider` in prisma/schema.prisma to "postgresql" and swap this URL.
DATABASE_URL="file:./dev.db"

# --- Auth (optional in Phase 1) ---------------------------------------------
# Leave BOTH blank and the app runs against a single local profile with no
# login wall. Fill BOTH in and Clerk takes over automatically — no code change.
# Get them at https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Ingestion --------------------------------------------------------------
# Shared secret for POST /api/ingest so the endpoint can be driven by a cron
# job later without exposing it publicly. Any random string.
CRON_SECRET="change-me-to-something-random"

# --- Email digest (Resend) ---
RESEND_API_KEY=""
DIGEST_FROM="onboarding@resend.dev"

# --- Adzuna (market breadth + salary) ---
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# --- LLM parsing (Gemini) ---
GEMINI_API_KEY=""

# --- Career-page crawl (Firecrawl) ---
FIRECRAWL_API_KEY=""

# Absolute origin for deep links in digest emails (prod: your Vercel URL)
APP_ORIGIN=""

# Optional error tracking (Sentry). Leave blank to log errors to the server console.
SENTRY_DSN=""
