{
  "manifest_version": 3,
  "name": "Kaam Se Kaam \u2014 Save this job",
  "version": "0.2.0",
  "description": "Save a LinkedIn / Naukri / Wellfound / careers-page job \u2014 or every job on a results page \u2014 into your Kaam Se Kaam tracker. Captures the page you're already viewing: no scraping, no automation.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*",
        "https://www.naukri.com/job-listings-*",
        "https://www.naukri.com/*",
        "https://wellfound.com/jobs/*",
        "https://wellfound.com/company/*/jobs/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*/careers/*",
        "https://*/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "extractors.js"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ]
    }
  ]
}